{
  "name": "fiberoffice-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && VITE_OPERATIONS=true vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "start": "vite --host 127.0.0.1",
    "test:stack": "node --env-file=.env.local scripts/stack-smoke.mjs",
    "build:local": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.80.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
